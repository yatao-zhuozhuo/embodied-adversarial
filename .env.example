OPENETA_LLM_PROVIDER=openai-compatible
OPENETA_LLM_MODEL=
OPENETA_LLM_API_BASE=
OPENETA_LLM_API_KEY=
OPENETA_LLM_TIMEOUT_S=60
OPENETA_LLM_MAX_ATTEMPTS=3
OPENETA_LLM_RETRY_BACKOFF_S=0.5
OPENETA_LLM_MAX_TOKENS=4096
# Leave unset to use the provider/model default. Set true or false explicitly
# when a collection shard must pin the chat-template behavior.
OPENETA_LLM_ENABLE_THINKING=
# Leave unset for the default multimodal path; set false for text-only models.
OPENETA_LLM_ENABLE_VISION=
OPENETA_LLM_FALLBACK_PROVIDER=
OPENETA_LLM_FALLBACK_MODEL=
OPENETA_LLM_FALLBACK_API_BASE=
OPENETA_LLM_FALLBACK_API_KEY=
OPENETA_LLM_FALLBACK_TIMEOUT_S=60
# Configure both values together. Deployment guide:
# https://github.com/Huaizz-shawen/object-memory-bank
OPENETA_OBJECT_MEMORY_BANK_URL=
OPENETA_OBJECT_MEMORY_BANK_API_KEY=
OPENETA_WEB_SEARCH_ENABLED=false
OPENETA_WEB_FETCH_ENABLED=false
