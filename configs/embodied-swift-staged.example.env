# Source this file from the repository root after adapting paths for your machine.
# It contains no credentials or model weights.
OPENETA_REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export SWIFT_VENV="${SWIFT_VENV:-${OPENETA_REPO_ROOT}/.venv-embodied-swift}"
export OPENETA_TILELANG_OVERLAY="${OPENETA_TILELANG_OVERLAY:-${OPENETA_REPO_ROOT}/.runtime/tilelang-0.1.14-py312}"
export MODEL_PATH="${MODEL_PATH:-${OPENETA_REPO_ROOT}/assets/local/Qwen3.5-4B}"
export INITIAL_ALICE_ADAPTER="${INITIAL_ALICE_ADAPTER:-${OPENETA_REPO_ROOT}/assets/local/alice_adapter}"
export INITIAL_BOB_ADAPTER="${INITIAL_BOB_ADAPTER:-${OPENETA_REPO_ROOT}/assets/local/bob_adapter}"
export BOOTSTRAP_ALICE_RUN="${BOOTSTRAP_ALICE_RUN:-${OPENETA_REPO_ROOT}/assets/local/bootstrap_alice_run}"
export TRAIN_GPU="${TRAIN_GPU:-0,1,2,3,4,5,6,7}"
export DATASET_GPU="${DATASET_GPU:-${TRAIN_GPU%%,*}}"
export OPENETA_MANISKILL_RENDER_GPU="${OPENETA_MANISKILL_RENDER_GPU:-${DATASET_GPU}}"
export OPENETA_MANISKILL_RENDER_BACKEND="${OPENETA_MANISKILL_RENDER_BACKEND:-sapien_cuda:0}"
